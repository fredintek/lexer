include _base.pug

+emailLayout('Your Bulls Yatırım login verification code.')
  table.email-wrapper(role='presentation' width='100%' cellpadding='0' cellspacing='0')
    tr
      td
        table.email-container(role='presentation' width='100%' cellpadding='0' cellspacing='0')
          tr
            td.email-header
              table(role='presentation' width='100%' cellpadding='0' cellspacing='0')
                tr
                  td.logo-row
                    table(role='presentation' cellpadding='0' cellspacing='0')
                      tr
                        td.logo-mark
                          svg(width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg')
                            path(d='M4 14L8 9L11 12L16 6' stroke='white' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round')
                        td(style='width:10px')
                        td.logo-text Bulls#[span .]Yatırım

          tr
            td.email-body
              p.badge Two-Factor Authentication
              h1.email-title Your login#[br] verification code
              p.email-subtitle
                | Hi #{user.fullname}, use the code below to complete your sign-in. This code expires at #[strong #{expiration}].

              //- OTP Display
              table(role='presentation' width='100%' cellpadding='0' cellspacing='0' style='margin-bottom:28px')
                tr
                  td(style='text-align:center')
                    .info-box(style='text-align:center')
                      p.info-box-label One-Time Password
                      p.info-box-value(style='font-size:36px; letter-spacing:0.2em; color:#0052FF')
                        = token

              table(role='presentation' width='100%' cellpadding='0' cellspacing='0' style='margin-bottom:24px')
                tr
                  td(style='text-align:center; background:#f8faff; border-radius:10px; padding:12px')
                    table(role='presentation' cellpadding='0' cellspacing='0' align='center')
                      tr
                        td(style='font-size:13px; color:#64748b')
                          | ⏱&nbsp; Expires in&nbsp;
                          strong(style='color:#0f172a') #{expiration}

              .alert-box
                strong 🔒 Never share this code.&nbsp;
                | Bulls Yatırım will never ask for your OTP via phone, chat, or email. If you didn't request this, secure your account immediately.

              //- .divider

              //- p(style='font-size:13px; color:#94a3b8; line-height:1.6')
              //-   | Having trouble?&nbsp;
              //-   a(href=supportUrl style='color:#0052FF; text-decoration:none; font-weight:500') Contact support

          tr
            td.email-footer
              p.footer-brand Bulls Yatırım
              //- .footer-links
              //-   a(href=termsUrl) Terms
              //-   a(href=privacyUrl) Privacy
              //-   a(href=supportUrl) Support
              p.footer-text
                | © #{new Date().getFullYear()} Bulls Yatırım. All rights reserved.#[br]
                | This is an automated security email.
