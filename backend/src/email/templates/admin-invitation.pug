include _base.pug

+emailLayout('You have been invited to join Bulls Yatırım as an ADMIN!.')
  table.email-wrapper(role='presentation' width='100%' cellpadding='0' cellspacing='0')
    tr
      td
        table.email-container(role='presentation' width='100%' cellpadding='0' cellspacing='0')
          tr
            td.email-header
              table(role='presentation' width='100%' cellpadding='0' cellspacing='0')
                tr
                  td.logo-row
                    table(role='presentation' cellpadding='0' cellspacing='0')
                      tr
                        td.logo-mark
                          svg(width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg')
                            path(d='M4 14L8 9L11 12L16 6' stroke='white' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round')
                        td(style='width:10px')
                        td.logo-text Bulls#[span .]Yatırım

          tr
            td.email-body
              p.badge(style='background:rgba(0,209,178,0.1); color:#00a896') Team Invitation
              h1.email-title You've been#[br] invited to join as an admin!
              p.email-subtitle
                | We have invited you to join Bulls Yatırım as an #[strong admin]. Set up your account to get started.

              //- Invitation details card
              table(role='presentation' width='100%' cellpadding='0' cellspacing='0' style='margin-bottom:28px')
                tr
                  td(style='background:#f8faff; border:1px solid #e2e8ff; border-radius:12px; padding:20px')
                    table(role='presentation' width='100%' cellpadding='0' cellspacing='0')
                      //- tr
                      //-   td(style='padding-bottom:12px; border-bottom:1px solid #e2e8f0')
                      //-     p(style='font-size:10px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#94a3b8; margin-bottom:4px') Invited By
                      //-     p(style='font-size:14px; font-weight:600; color:#0f172a') #{invitedBy}
                      tr
                        td(style='padding:12px 0; border-bottom:1px solid #e2e8f0')
                          p(style='font-size:10px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#94a3b8; margin-bottom:4px') Your Role
                          p(style='font-size:14px; font-weight:600; color:#0052FF') Admin
                      tr
                        td(style='padding-top:12px')
                          p(style='font-size:10px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#94a3b8; margin-bottom:4px') Fullname
                          p(style='font-size:14px; font-weight:600; color:#0f172a') #{fullname}
                      tr
                        td(style='padding-top:12px')
                          p(style='font-size:10px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#94a3b8; margin-bottom:4px') Email
                          p(style='font-size:14px; font-weight:600; color:#0f172a') #{email}
                      tr
                        td(style='padding-top:12px')
                          p(style='font-size:10px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#94a3b8; margin-bottom:4px') Password
                          p(style='font-size:14px; font-weight:600; color:#0f172a') #{tempPassword}

              a.btn-primary(href=loginUrl) Get Started →

              p(style='font-size:13px; color:#64748b; line-height:1.6; margin-bottom:24px; padding:12px 16px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px')
                | 🔑&nbsp;
                strong(style='color:#15803d') For your security:&nbsp;
                | once you've logged in, please reset your password immediately from your account settings.

              .alert-box
                strong ⚠ Not expecting this?&nbsp;
                | If you didn't expect an invitation from Bulls Yatırım, you can ignore this email. No account will be created without your action.

          tr
            td.email-footer
              p.footer-brand Bulls Yatırım
              //- .footer-links
              //-   a(href=termsUrl) Terms
              //-   a(href=privacyUrl) Privacy
              //-   a(href=supportUrl) Support
              p.footer-text
                | © #{new Date().getFullYear()} Bulls Yatırım. All rights reserved.
