extends _base.pug

block content
  table.email-wrapper(role='presentation' width='100%' cellpadding='0' cellspacing='0')
    tr
      td
        table.email-container(role='presentation' width='100%' cellpadding='0' cellspacing='0')
          tr
            td.email-header
              table(role='presentation' width='100%' cellpadding='0' cellspacing='0')
                tr
                  td.logo-row
                    table(role='presentation' cellpadding='0' cellspacing='0')
                      tr
                        td.logo-mark
                          svg(width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg')
                            path(d='M4 14L8 9L11 12L16 6' stroke='white' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round')
                        td(style='width:10px')
                        td.logo-text Bulls#[span .]Yatırım

          tr
            td.email-body
              p.badge Email Verification
              h1.email-title Confirm your#[br] email address
              p.email-subtitle
                | Hi #{user.fullname}, copy the token below to verify your email and activate your Bulls Yatırım account. This link expires in #[strong #{expiration}].

              //- a.btn-primary(href=verificationUrl) Verify Email Address

              //- .divider
              p(style='font-size:12px; color:#0052FF; word-break:break-all; background:#f8faff; padding:12px 14px; border-radius:8px; font-family:monospace')
                = token

              .divider

              .alert-box
                strong ⚠ Didn't create an account?&nbsp;
                | If you didn't sign up for Bulls Yatırım, you can safely ignore this email. No account will be created.

          tr
            td.email-footer
              p.footer-brand Bulls Yatırım
              //- .footer-links
              //-   a(href=termsUrl) Terms
              //-   a(href=privacyUrl) Privacy
              //-   a(href=supportUrl) Support
              p.footer-text
                | © #{new Date().getFullYear()} Bulls Yatırım. All rights reserved.
